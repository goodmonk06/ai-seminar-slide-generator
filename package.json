{
  "name": "ai-seminar-slide-generator",
  "version": "1.0.0",
  "description": "AI-powered slide outline generator for presentations using Claude API",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:rich": "tsx scripts/seed-rich.ts",
    "db:clean": "rm -rf data/*",
    "db:reset": "npm run db:clean && npm run db:seed",
    "db:reset:rich": "npm run db:clean && npm run db:seed:rich",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run type-check && npm run lint && npm run test",
    "docker:build": "docker build -t ai-seminar-slide-generator .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:clean": "docker compose down -v && docker rmi ai-seminar-slide-generator || true"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:20856/git/goodmonk06/ai-seminar-slide-generator"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "next": "^16.0.3",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "happy-dom": "^20.0.10",
    "tsx": "^4.20.6",
    "vitest": "^4.0.10"
  }
}
